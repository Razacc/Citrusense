{
  "expo": {
    "name": "CitruSense",
    "slug": "citrusense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A12"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.citrusense.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-512.png",
        "backgroundColor": "#0F1A12"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon-192.png"
    }
  }
}
